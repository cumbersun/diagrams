        <mxCell id="t2H5Lw-tumbk8teAm2dc-15" value="&lt;font style=&quot;color: rgb(0, 204, 0);&quot; face=&quot;Comic Sans MS&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;aload_document -&amp;gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;load_document&amp;nbsp;&lt;/span&gt;&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;rounded=1;sketch=1;curveFitting=1;jiggle=2;container=0;fillColor=#d5e8d4;strokeColor=#82b366;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1">
