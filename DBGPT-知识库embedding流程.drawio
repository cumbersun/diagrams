        <mxCell id="t2H5Lw-tumbk8teAm2dc-4" value="&lt;font face=&quot;Comic Sans MS&quot; color=&quot;#00cc00&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;async_doc_embedding&lt;/span&gt;&lt;/font&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=40;rounded=1;sketch=1;curveFitting=1;jiggle=2;container=0;fillColor=#d5e8d4;strokeColor=#82b366;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="440" width="510" height="170" as="geometry" />
